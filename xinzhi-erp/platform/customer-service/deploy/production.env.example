POSTGRES_PASSWORD=replace-with-a-random-production-password
GOPROXY=https://proxy.golang.org,direct
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# Keep all protected production data on the separately mounted data disk.
XZDESK_DATA_MOUNT=/data
XZDESK_POSTGRES_HOST_DIR=/data/xzdesk/postgres
XZDESK_UPLOAD_HOST_DIR=/data/xzdesk/uploads
XZDESK_BACKUP_DIR=/data/xzdesk/backups
XZDESK_BACKUP_STAGING_DIR=/data/xzdesk/backup-staging
XZDESK_POSTGRES_TLS_DIR=/data/xzdesk/postgres-tls
XZDESK_DEPLOY_STATE_HOST_DIR=/opt/xzdesk/runtime/deploy
XZDESK_BACKUP_RETENTION_DAYS=30
# Public age recipients only. Keep the matching private identity offline and
# outside every application, data, upload, and backup directory.
XZDESK_BACKUP_AGE_RECIPIENTS_FILE=/etc/xzdesk/backup-recipients.txt
# The production layout keeps PostgreSQL, uploads, and backups on the separately
# mounted provider-encrypted data disk. Record provider evidence covering all
# three stores; the preflight deliberately rejects a partial claim.
XZDESK_AT_REST_ENCRYPTION_MODE=provider-managed
XZDESK_AT_REST_ENCRYPTION_EVIDENCE_FILE=/etc/xzdesk/at-rest-encryption.evidence
# Keep true in production so a missing data-disk mount fails closed.
XZDESK_REQUIRE_DATA_MOUNT=true

# Public browser URL served by Caddy or Cloudflare Tunnel. Never use api:8787,
# localhost, or a Docker service name here.
XZDESK_DOMAIN=your-domain
PUBLIC_BASE_URL=https://your-domain

# Public Xinzhi ERP App Store pages. These must contain real review-ready values.
XZ_ERP_LEGAL_NAME=Your legal entity name
XZ_ERP_SUPPORT_EMAIL=support@xzkj.ai
XZ_ERP_PRIVACY_EFFECTIVE_DATE=2026-07-31
SHOPIFY_PUBLIC_COMPANY_WEBSITE=https://www.xzkj.ai/

# Public retention wording for the Shopify privacy page.
SHOPIFY_PUBLIC_ORDER_RETENTION=Personal data is retained while the merchant uses the service and it remains necessary for order fulfillment or support. Verified deletion and Shopify redaction requests are completed within 30 days; only anonymized transaction or security facts required by law may be retained longer.
SHOPIFY_PUBLIC_BACKUP_RETENTION=Encrypted rolling backups are retained for no more than 30 days. Deleted personal data expires from backups within that period and is not restored for normal operations; after disaster recovery, applicable deletion requests are reapplied.
SHOPIFY_PUBLIC_DELETION_PROCESS=Verified Shopify privacy requests are recorded, tenant-scoped, exported or redacted by an authorized administrator, checked for customer-service attachments and records, and completed within 30 days with retry and escalation for failures.

# Xinzhi ERP public Shopify App. Deploy platform/customer-service/shopify.app.toml
# through Shopify CLI so app-specific and compliance webhook subscriptions are active.
SHOPIFY_APP_DISTRIBUTION=public
SHOPIFY_APP_API_KEY=
SHOPIFY_APP_API_SECRET=
SHOPIFY_APP_BASE_URL=https://your-domain
SHOPIFY_APP_CALLBACK_PATH=/auth/callback
SHOPIFY_APP_API_VERSION=2026-07
# Keep this exact value synchronized with shopify.app.toml and the reviewed
# functionality. Do not fall back to the broader legacy customer-service set.
# Current reviewable release is dispute-metadata only. Restricted Shopify
# Payments evidence access is not eligible yet and remains in Shopify Admin.
SHOPIFY_APP_SCOPES=read_all_orders,read_customers,read_locations,read_products,read_shopify_payments_disputes,write_inventory,write_merchant_managed_fulfillment_orders,write_order_edits,write_orders,write_returns

# Legacy customer-service independent App settings. These remain for existing
# per-store Xzdesk deployments and are not the Xinzhi ERP public App credentials.
# SHOPIFY_API_KEY/SECRET are legacy-only uninstall webhook compatibility values.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_all_orders,read_customers,read_locations,read_products,read_shopify_payments_disputes,write_inventory,write_merchant_managed_fulfillment_orders,write_order_edits,write_orders,write_returns
SHOPIFY_API_VERSION=2026-01
# Keep this different from OAuth secrets and never commit the production value.
SHOPIFY_CREDENTIALS_ENCRYPTION_KEY=
SHOPIFY_CLI_PATH=shopify
SHOPIFY_EXTENSION_TEMPLATE_DIR=/opt/xzdesk/extensions/xinzhi-support-chat

# Internal service-to-service connection probe forwarding. Use HTTPS unless the
# independent connector is a separate process bound to this host's loopback.
XZ_ERP_CONNECTOR_TOKEN=
XZ_SHOPIFY_CONNECTOR_INTERNAL_BASE_URL=https://shopify-connector.internal

# AI reply drafts. Keep this secret only in the server environment.
AI_BASE_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-v4-flash
AI_API_KEY=
AI_SETTINGS_ENCRYPTION_KEY=

# Outlook / Microsoft Graph OAuth settings.
# Register https://your-domain/outlook/callback as the Web redirect URI.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
OUTLOOK_SCOPES=offline_access User.Read Mail.Read Mail.ReadWrite Mail.Send
# OUTLOOK_BASE_URL=https://your-domain
# Random secret used to derive Microsoft Graph webhook clientState values.
OUTLOOK_WEBHOOK_SECRET=

# Gmail / Google OAuth settings. A Google test app still needs this exact
# authorized redirect URI: https://your-domain/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send
# GMAIL_BASE_URL=https://your-domain
GMAIL_PUBSUB_TOPIC=projects/your-project-id/topics/xzdesk-gmail-events
GMAIL_PUBSUB_AUDIENCE=https://your-domain/webhooks/email/gmail
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=xzdesk-pubsub-push@your-project-id.iam.gserviceaccount.com

# Push is primary; this bounded poll recovers delayed or dropped notifications.
EMAIL_RECONCILE_INTERVAL=24h

# Optional Shopify Admin API access tokens.
# Prefer per-shop tokens derived from the myshopify domain:
# SHOPIFY_ADMIN_ACCESS_TOKEN_DEMO_MYSHOPIFY_COM=shpat_xxx
#
# For a single-shop deployment you can also use:
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
