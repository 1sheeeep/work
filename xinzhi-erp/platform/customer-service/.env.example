SUPPORT_PLATFORM_ADDR=127.0.0.1:8787
XZDESK_FRONTEND_PORT=5173
VITE_XZDESK_BACKEND=http://127.0.0.1:8787
# Local XZ ERP integration uses one explicit loopback topology. Prefer
# tools/start-erp-local.ps1 so the imported Go runtime receives these values.
XZDESK_ALLOWED_ORIGINS=http://127.0.0.1:18888
XZDESK_ERP_IAM_BASE_URL=http://127.0.0.1:8080
XZDESK_PUBLIC_ORIGIN=http://127.0.0.1:8787
ERP_XZ_ERP_APP_CONNECTOR_TOKEN=replace-with-the-same-random-local-service-token
XZDESK_LOCAL_DEMO=1
XZDESK_DATABASE_SCHEMA=customer_service
DATABASE_URL=postgres://customer_service_runtime:not-a-real-secret-customer-service-runtime@127.0.0.1:54329/shopify_support?sslmode=disable
XZDESK_DATABASE_MIGRATION_URL=postgres://customer_service_migrator:not-a-real-secret-customer-service-migrator@127.0.0.1:54329/shopify_support?sslmode=disable

# Shared Shopify settings used when publishing every store's independent App.
# SHOPIFY_API_KEY/SECRET are legacy-only uninstall webhook compatibility values; leave them empty for a new deployment.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8787
SHOPIFY_SCOPES=read_all_orders,read_customers,read_locations,read_products,read_shopify_payments_disputes,write_inventory,write_merchant_managed_fulfillment_orders,write_order_edits,write_orders,write_returns
SHOPIFY_API_VERSION=2026-01
# Encrypt per-shop Client Secret and App Automation Token at rest.
# Use a long random value in production. If omitted, AI_SETTINGS_ENCRYPTION_KEY is used as a compatibility fallback.
SHOPIFY_CREDENTIALS_ENCRYPTION_KEY=
SHOPIFY_CLI_PATH=shopify.cmd
SHOPIFY_EXTENSION_TEMPLATE_DIR=extensions/xinzhi-support-chat

# Independent connector process used by the ERP connection.v2 forwarder. The
# local topology uses the same existing workload credential in both directions.
XZ_ERP_CONNECTOR_TOKEN=replace-with-a-random-local-service-token
XZ_SHOPIFY_CONNECTOR_INTERNAL_BASE_URL=http://127.0.0.1:8790

# AI reply drafts. The key stays on the server and is never sent to the browser.
# Compatible with DeepSeek and OpenAI-compatible chat completion endpoints.
AI_BASE_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-v4-flash
AI_API_KEY=
AI_SETTINGS_ENCRYPTION_KEY=

# Outlook / Microsoft Graph OAuth settings.
# Register a Microsoft Entra web app and add this redirect URI:
#   ${PUBLIC_BASE_URL}/outlook/callback
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
OUTLOOK_SCOPES=offline_access User.Read Mail.Read Mail.ReadWrite Mail.Send
OUTLOOK_WEBHOOK_SECRET=

# Gmail / Google OAuth settings.
# Register a Google Web application and add this redirect URI:
#   ${PUBLIC_BASE_URL}/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send
GMAIL_PUBSUB_TOPIC=projects/your-project-id/topics/xzdesk-gmail-events
GMAIL_PUBSUB_AUDIENCE=https://your-domain/webhooks/email/gmail
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=xzdesk-pubsub-push@your-project-id.iam.gserviceaccount.com
EMAIL_FALLBACK_INTERVAL=15m

# Optional Shopify Admin API access tokens.
# SHOPIFY_ADMIN_ACCESS_TOKEN_DEMO_MYSHOPIFY_COM=shpat_xxx
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
