POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=change-this-database-password
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
APP_BOOTSTRAP_GROUP_NAME=示例集团
APP_BOOTSTRAP_GROUP_SHORT_NAME=集团总部
APP_LOGIN_MAX_FAILURES=5
APP_GATEWAY_TIMEOUT=3s
APP_GATEWAY_MAX_CONCURRENT=8
APP_GATEWAY_RATE_LIMIT_PER_MINUTE=120
APP_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
APP_GATEWAY_CIRCUIT_OPEN_DURATION=30s
APP_AUTO_REPLY_ENABLED=false
APP_BROWSER_MONITOR_ONLY=true
APP_AUTO_REPLY_POLL_INTERVAL=15s
APP_AUTO_REPLY_LEASE_DURATION=45s
APP_OPENAI_ENABLED=false
# 仅部署环境填写，绝不提交真实 Key 到仓库。
OPENAI_API_KEY=
# 填写本组织已启用且支持 Structured Outputs 的 OpenAI 模型。
OPENAI_MODEL=
OPENAI_TIMEOUT=60s
# 启用后，PDF/DOCX 在提取文本前必须通过内部 ClamAV 扫描；扫描服务异常时拒绝处理。
APP_RESUME_MALWARE_SCAN_ENABLED=false
APP_RESUME_MALWARE_SCAN_HOST=clamav
APP_RESUME_MALWARE_SCAN_PORT=3310
# 扫描件 OCR 仅运行在本机 Docker 网络内；启用时仍要求病毒扫描门禁同步启用。
APP_RESUME_OCR_ENABLED=false
APP_RESUME_OCR_HOST=resume-ocr
APP_RESUME_OCR_PORT=8090
