{
  "manifest_version": 3,
  "name": "招聘控制台·BOSS 会话伴随助手",
  "version": "0.8.4",
  "description": "在已登录的 BOSS 页面上检测超时未回复会话；不读取 Cookie，遇验证码或风险提示立即停止。",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://*.zhipin.com/*", "http://localhost:8088/*", "http://localhost:8091/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://*.zhipin.com/*", "http://localhost:8091/*"],
    "js": ["content-script.js"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": { "default_title": "BOSS 会话伴随助手", "default_popup": "popup.html" }
}
